{
  "openapi": "3.1.0",
  "info": {
    "title": "Regulatory Intelligence Platform",
    "version": "0.1.0",
    "description": "Exported offline from azure-rag-platform with app.openapi(); the server-sent-event stream of /v1/answer is not described by OpenAPI."
  },
  "paths": {
    "/v1/answer": {
      "post": {
        "summary": "Answer Route",
        "operationId": "answer_route_v1_answer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Question"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/retrieve": {
      "post": {
        "summary": "Retrieve Route",
        "operationId": "retrieve_route_v1_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Question"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PhaseEvent"
                  },
                  "type": "array",
                  "title": "Response Retrieve Route V1 Retrieve Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "summary": "Feedback Route",
        "operationId": "feedback_route_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Feedback"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Feedback": {
        "properties": {
          "trace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Trace Id"
          },
          "helpful": {
            "type": "boolean",
            "title": "Helpful"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "helpful"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PhaseEvent": {
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "plan",
              "search",
              "rerank",
              "answer",
              "verify"
            ],
            "title": "Phase"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "phase",
          "trace_id",
          "elapsed_ms"
        ],
        "title": "PhaseEvent"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Question"
          },
          "conversation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Question"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}