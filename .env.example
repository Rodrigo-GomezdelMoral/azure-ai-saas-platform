# Local defaults for the gateway. The cluster receives the real values from the deployment; nothing here is a secret.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
API_AUDIENCE=00000000-0000-0000-0000-000000000000
ADMIN_ROLE=Platform.Admin
TENANT_SCOPE=
REQUIRE_AUTH=false
REDIS_HOST=<redis-name>.<region>.redis.azure.net
REDIS_PORT=10000
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=saas
SERVICEBUS_NAMESPACE=<servicebus-namespace>.servicebus.windows.net
EVENTGRID_ENDPOINT=https://<topic>.<region>-1.eventgrid.azure.net/api/events
FOUNDRY_ENDPOINT=https://<foundry-account>.cognitiveservices.azure.com/
EMBEDDING_DEPLOYMENT=text-embedding-3-small
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SHARED_INDEX=regulations
KEYVAULT_URL=https://<vault-name>.vault.azure.net/
SIGNING_KEY_NAME=credential-signing
UPSTREAM_URL=https://<rag-platform-api>
UPSTREAM_AUDIENCE=api://00000000-0000-0000-0000-000000000000
